{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://block-general-tests.local/schemas/design-checklist.schema.json",
  "title": "Per-block design checklist",
  "type": "object",
  "required": ["source", "requirements", "overrides"],
  "properties": {
    "source": {
      "type": "object",
      "required": ["fileKey", "nodeId"],
      "properties": {
        "fileKey": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "nodeId": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" }
      },
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "checkType", "sourceText", "expected", "checkStage", "params"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "checkType": { "enum": ["color-default", "color-scope", "typography", "module-width", "height-fit", "text-truncation", "image-ratio", "overflow-threshold", "nav-hierarchy-levels", "search-box-per-field", "default-expand", "selected-tag-behaviour", "mobile-layout", "manual"] },
          "sourceText": { "type": "string", "minLength": 1 },
          "expected": {
            "not": { "anyOf": [
              { "required": ["lineHeight"] },
              { "required": ["line-height"] }
            ] }
          },
          "checkStage": { "enum": ["editor", "front", "both"] },
          "state": {
            "type": "object", "required": ["kind", "target"],
            "properties": {
              "kind": { "enum": ["hover", "focus", "selected", "expanded", "active"] },
              "target": { "type": "string", "minLength": 1 },
              "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 },
              "restoreTarget": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "params": { "type": "object", "properties": { "ratioSource": { "enum": ["natural", "rendered-content", "rendered-element", "both"] } } }
        },
        "allOf": [{
          "if": { "required": ["state"] },
          "then": { "properties": {
            "checkType": { "enum": ["color-scope", "typography"] },
            "checkStage": { "const": "front" }
          } }
        }],
        "additionalProperties": false
      }
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirementId", "status", "reason"],
        "properties": {
          "requirementId": { "type": "string" },
          "status": { "enum": ["waived", "human-review"] },
          "reason": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "whenReasonCodes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } }
        },
        "allOf": [{ "if": { "required": ["whenReasonCodes"] }, "then": { "properties": { "status": { "const": "human-review" } } } }],
        "additionalProperties": false
      }
    },
    "unsupportedRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sourceText", "reason"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "sourceText": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "scopeOverrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirementId", "sourceText", "resolvedScope", "reason"],
        "properties": {
          "requirementId": { "type": "string" },
          "sourceText": { "type": "string", "minLength": 1 },
          "resolvedScope": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
